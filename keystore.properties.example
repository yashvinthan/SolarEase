# Keystore configuration template for SolarEase release signing.
# Copy this file to 'keystore.properties' (which is gitignored) and fill in your actual values.
# NEVER commit your actual keystore or passwords to version control!

KEYSTORE_PATH=/path/to/your/release-key.jks
KEY_ALIAS=solarease_upload_key
STORE_PASSWORD=your_store_password_here
KEY_PASSWORD=your_key_password_here

